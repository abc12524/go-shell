# go-shell 环境变量模板（与 shell-tool .env 兼容，新增 SERVER_* 与 PYTHON_BIN）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== LLM 接入方式 =====
# responses = DeepSeek 官方 Responses API（默认；支持服务端内置 web_search）
# chat      = OpenAI 兼容 Chat Completions API（OpenCode Zen / OpenCode Go 等网关）
DEEPSEEK_API_TYPE=responses
LLM_PROVIDER=
LLM_SESSION_HEADER=
LLM_USER_AGENT=

# ===== HTTP 服务（go-shell server）=====
# 绑定 IP：127.0.0.1（仅本机）或 0.0.0.0（所有网卡）
SERVER_HOST=127.0.0.1
# 监听端口（在配置文件修改，无需改代码）
SERVER_PORT=8000

# ===== 中途插话（POST /interject）=====
# 一轮还在干活时，用户想改方向：把这句话递进正在跑的那一轮，等它走到工具边界
# 再作为 user 消息进入上下文（不杀进程、中途工作不丢）。
# 验证串必须正好 8 位，**客户端请求要带同一个值才工作**（请求头 X-Interject-Key）；
# 留空或长度不是 8 位 = 功能关闭，/interject 直接 403。
INTERJECT_KEY=
# 插话等待上限（秒）：到点还没落到工具边界就返回 timeout，由客户端按新消息重发
INTERJECT_GRACE=20

# ===== skill 运行时 =====
# skill/*.py 仍是 Python 脚本，由该解释器执行（runner 已内嵌进二进制，无需携带 runner.py）
PYTHON_BIN=python3
# 冒号分隔的目录，前置到 skill 子进程的 PATH（skill 内再调 python/pip 装的 CLI 时可命中）
# 例：PYTHON_PATH=/root/.venv/bin
PYTHON_PATH=

OPENVIKING_URL=
OPENVIKING_KEY=
OPENVIKING_USER=
OPENVIKING_AGENT=default

# ===== 用户自定义提示（每会话注入一次）=====
user_tips=

# ===== OpenViking 记忆检索 =====
OV_FIND_THRESHOLD=0.4
OV_FIND_LIMIT=3
OV_INJECT=question
OV_PROFILE=false
OV_CAPTURE=false
OV_CAPTURE_ASSISTANT_TURNS=true
OV_CAPTURE_MAX_LENGTH=24000
OV_CAPTURE_TOOL_MAX_CHARS=1000000
OV_MIN_QUERY_LENGTH=3
OV_RECALL_DEDUP_TURNS=5
OV_PROFILE_TOKEN_BUDGET=1000
OV_WORKSPACE_PEER=false
OV_PEER_ID=

# ===== 数据库存储 =====
DB_ONLINE=true
SQLITE_DB_PATH=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# ===== 工具调用 =====
MAX_TOOL_ROUNDS=6
MAX_API_ATTEMPTS=4
LLM_WEB_SEARCH=false
DEBUG_SEND_SEQ=0

# ===== skill 远程仓库 =====
SKILL_HUB_TYPE=
SKILL_HUB_BASE=
SKILL_HUB_REPO=abc12524/shell-skills
SKILL_HUB_BRANCH=main
SKILL_HUB_TOKEN=
