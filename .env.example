# go-shell 环境变量模板（与 shell-tool .env 兼容，新增 SERVER_* / REMOTE_* / PYTHON_BIN）
#
# 本文件默认位置：~/.config/go-shell/go.config（Windows 同为 %USERPROFILE%\.config\go-shell）
# 老部署（二进制旁边有 .env）继续用那份，配置与数据都不会搬家。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== LLM 接入方式 =====
# responses = DeepSeek 官方 Responses API（默认；支持服务端内置 web_search）
# chat      = OpenAI 兼容 Chat Completions API（OpenCode Zen / OpenCode Go 等网关）
DEEPSEEK_API_TYPE=responses
LLM_PROVIDER=
LLM_SESSION_HEADER=
LLM_USER_AGENT=

# ===== HTTP 服务（go-shell server）=====
# 绑定 IP：127.0.0.1（仅本机）或 0.0.0.0（所有网卡）
SERVER_HOST=127.0.0.1
# 监听端口（在配置文件修改，无需改代码）
SERVER_PORT=8000

# ===== 访问验证码（API 服务全局校验）=====
# 至少 8 位（字符数，够长更好）时，除 /health 以外的接口都必须带对，否则 401：
#   请求头 Authorization: Bearer <你的验证码>
# 留空或短于 8 位 = 不做校验（仅本机/内网自用）；SERVER_HOST=0.0.0.0 时务必设置。
# 例：头 -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 16
API_ACCESS_KEY=

# ===== 中途插话（POST /interject）=====
# 一轮还在干活时用户改主意：把这句话递进正在跑的那一轮，等它走到工具边界
# 再作为 user 消息进入上下文（不杀进程、中途工作不丢）。
# 等待上限（秒）：到点还没落到工具边界就返回 timeout，由客户端按新消息重发。
INTERJECT_GRACE=45

# ===== 远程主机（客户端模式：go-shell -h <别名>）=====
# 每项 别名=地址:端口:访问码，多项用逗号分隔；访问码 = 对端 .env 的 API_ACCESS_KEY
# 例：REMOTE_HOSTS=nuc5=192.0.2.10:8018:yourkey1
REMOTE_HOSTS=
# -h 不带值（或 -h +default）时用的默认目标
REMOTE_HOST=
REMOTE_PORT=8000
REMOTE_KEY=
# 建连与 /health 检查的超时（秒）；流式对话本身不设总超时
REMOTE_TIMEOUT=15

# ===== skill 运行时 =====
# skill/*.py 仍是 Python 脚本，由该解释器执行（runner 已内嵌进二进制，无需携带 runner.py）
# PYTHON_BIN 带目录（如 /root/.venv/bin/python3）时，解释器所在目录会自动前置到
# skill 子进程的 PATH——venv 里 pip 装的 CLI 对 skill 直接可见（原 PYTHON_PATH 已并入此项）
PYTHON_BIN=python3

# ===== 目录（相对路径按二进制所在目录解析）=====
# skill 脚本目录（默认 <配置根>/skill；目录名会作为 Python 包前缀，建议用字母/数字/下划线）
SKILL_DIR=
# 数据目录（默认 <配置根>/data，SQLite 默认落 <数据目录>/shell_tool.db）
DATA_DIR=

OPENVIKING_URL=
OPENVIKING_KEY=
OPENVIKING_USER=
OPENVIKING_AGENT=default

# ===== 用户自定义提示（每会话注入一次）=====
user_tips=

# ===== OpenViking 记忆检索 =====
OV_FIND_THRESHOLD=0.5
OV_FIND_LIMIT=2
OV_INJECT=question
OV_PROFILE=false
OV_CAPTURE=false
OV_CAPTURE_ASSISTANT_TURNS=true
OV_CAPTURE_MAX_LENGTH=24000
OV_CAPTURE_TOOL_MAX_CHARS=1000000
OV_MIN_QUERY_LENGTH=3
OV_RECALL_DEDUP_TURNS=5
OV_PROFILE_TOKEN_BUDGET=1000
OV_WORKSPACE_PEER=false
OV_PEER_ID=

# ===== 数据库存储 =====
DB_ONLINE=true
SQLITE_DB_PATH=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# ===== 工具调用 =====
MAX_TOOL_ROUNDS=8
MAX_API_ATTEMPTS=4
LLM_WEB_SEARCH=false
DEBUG_SEND_SEQ=0

# ===== skill 远程仓库 =====
SKILL_HUB_TYPE=
SKILL_HUB_BASE=http://192.0.2.10:3000
SKILL_HUB_REPO=your-org/shell-skills
SKILL_HUB_BRANCH=main
SKILL_HUB_TOKEN=
